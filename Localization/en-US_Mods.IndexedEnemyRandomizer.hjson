Configs: {
	RandomizerConfig: {
		DisplayName: Indexed Enemy Randomizer

		IncludeOppositeEvil: {
			Label: Include opposite-evil enemies in Hardmode
			Tooltip: Include all enemies from the other world evil in the Hardmode pool, including its pre-Hardmode enemies. In combined-pool mode they join the combined pool. Off excludes them from replacement targets. On by default. Applies on first load or /regeneratemapping.
		}

		RandomizeTownShimmer: {
			Label: Randomize town NPC shimmer appearance
			Tooltip: Give supported town NPCs a 50% chance of their shimmer appearance when spawned or rescued. Off leaves vanilla appearance behavior intact. Does not change existing NPCs or mappings. On by default.
		}

		RandomizeTownNpcs: {
			Label: Include town NPCs in randomization
			Tooltip: Add ordinary resident town NPCs to the normal mapping pools. Their spawns can become enemies, and enemies can become town NPCs. Pets, rescue forms, and special NPCs remain protected. Off by default. Applies on first load or /regeneratemapping.
		}

		GroupOldOnesArmyTiers: {
			Label: Group Old One's Army enemy tiers
			Tooltip: Give each Old One's Army species one mapping across all tiers. Its earliest tier determines its pool. Spawn tier 2 after a mechanical boss and tier 3 after Golem, using the earliest available form when needed. Off keeps tiers separate. On by default. Applies on first load or /regeneratemapping; progression only changes the spawned tier.
		}

		LimitBosses: {
			Label: Limit each boss to one active encounter
			Tooltip: On: prevent duplicate bosses of the same type. Off: allow multiple encounters, including multiple pairs of Twins. Miniboss limits have their own setting. On by default. Does not change mappings.
		}

		GroupGoldCritters: {
			Label: Group critters with their gold variants
			Tooltip: Share one mapping for each critter family and its gold variants. Use vanilla gold-critter odds, normally 1 in 400, adjusted by the nearest living player's luck. Independent of banner grouping. On by default. Applies on first load or /regeneratemapping.
		}

		GroupMiscVariants: {
			Label: Miscellaneous groupings
			Tooltip: Group Bees, Scorpions, Ducks, Fairies, Macaws, Cockatiels, ordinary Dragonflies, Squirrels, Penguins, and Birds into their respective families. Choose a random member per spawn. Gold-critter odds retain priority. Off leaves existing banner, gold, and movement-form groups intact. On by default. Applies on first load or /regeneratemapping.
		}

		EarlyEvilSolutionShimmer: {
			Label: Shimmer evil solutions at any time
			Tooltip: Allow Red Solution and Purple Solution to shimmer into each other at any progression stage. No Moon Lord defeat required. Off restores the normal conversions. On by default. Does not change enemy mappings.
		}

		PreserveNpcChildren: {
			Label: Keep NPC-spawned creatures unchanged
			Tooltip: On: creatures spawned by other NPCs keep their original species, including helpers spawned through projectiles. Off: randomize them normally. Required boss parts stay intact in either mode. Event portals and the Cultist ritual still produce randomized encounters. On by default.
		}

		LimitMiniBosses: {
			Label: Include minibosses in the one-at-a-time limit
			Tooltip: Limit each miniboss type to one active encounter, including event minibosses, biome mimics, Dreadnautilus, Mothron, Ice Golem, Sand Elemental, Paladin, Goblin Warlock, and Pirate Captain. Full bosses have their own limit setting. On by default.
		}

		SeparateProgressionPools: {
			Label: Separate pre-Hardmode and Hardmode pools
			Tooltip: On: keep separate progression pools. Off: shuffle all eligible NPCs together, allowing Hardmode and both world evils from the start. Boss restrictions and protected NPC exclusions still apply. Applies on first load or /regeneratemapping.
		}

		IncludeBosses: {
			Label: Include bosses in randomization
			Tooltip: Include eligible bosses and event bosses in randomization. Off keeps their original spawns and removes them from replacement targets. On by default. Applies on first load or /regeneratemapping. Existing bosses and normal summons remain available.
		}

		BlockEarlyHardmodeStatueLoot: {
			Label: Block Hardmode statue loot before Hardmode
			Tooltip: Hardmode species spawned from statues drop nothing in pre-Hardmode worlds. Uses the actual enemy species, not its mapped source or world evil. Off restores vanilla restrictions. On by default. Does not change mappings.
		}

		ReduceStatueLoot: {
			Label: Reduce statue loot without a vanilla rate rule
			Tooltip: Statue enemies without an existing rate rule drop items at 20% of their normal chance. Existing rates remain unchanged. Uses vanilla statue rules, including requiring player or minion damage. Off restores original rates. On by default. Does not change mappings.
		}

		CombineTwins: {
			Label: Treat the Twins as one encounter
			Tooltip: Share one mapping for Retinazer and Spazmatism. Their replacement encounter spawns both Twins together. On by default. Applies on first load or /regeneratemapping; direct NPC commands still spawn exactly the requested NPC.
		}

		GroupNpcVariants: {
			Label: Group NPC variants by banner
			Tooltip: Treat NPCs sharing a banner as one mapping entry and randomly choose a variant per spawn. Respects the separate progression pools setting. Applies on first load or /regeneratemapping.
		}

		LegacyEventCredit: {
			Label: Legacy event kill credit
			Tooltip: Off: event progress follows the seeded replacement enemies. On: actual vanilla event enemies count, as in v0.7. Goblin Scouts do not award invasion credit. Progress bars stay visible in either mode. Applies to all players.
		}

		LegacyPillarCredit: {
			Label: Legacy pillar kill credit
			Tooltip: Off: killing the seeded replacements of a pillar's enemies reduces its shield. On: actual pillar enemies count, as in v0.7. Kills count anywhere on the map in either mode. Applies to all players.
		}
	}
}
